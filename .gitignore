# Data: raw and intermediate files are not versioned (see docs/research/sources.md for where to get them)
data/raw/
data/interim/
data/external/
*.csv
*.xlsx
*.parquet

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
build/
reports/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Notebook build folder (the notebook rebuilds the package here)
notebooks/_nb_pkg/

